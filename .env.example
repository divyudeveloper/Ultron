# ULTRON environment configuration
# Copy this file to .env and fill only the providers you actually use.

NODE_ENV=development
PORT=3000

# AI provider: ollama | google | openai
AI_PROVIDER=ollama
AI_FALLBACK_TO_LOCAL=false

# Ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=90000

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Web/research tuning
WEB_TIMEOUT_MS=15000
MAX_WEB_CONTENT_BYTES=2000000
